<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>form</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"> 
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

</head>
<body>
    
<form  style="padding: 5%;">
    <h1 align="center" style="margin-top: 3%;">FORM PEMESANAN PRODUK UMKM</h1>
    <br><br><br>
  <div class="form-group row">
    <label for="text" class="col-2 col-form-label">Nama Penerima</label> 
    <div class="col-8">
      <div class="input-group">
        <div class="input-group-prepend">
          <div class="input-group-text">
            <i class="fa fa-address-book"></i>
          </div>
        </div> 
        <input id="text" name="text" type="text" class="form-control">
      </div>
    </div>
  </div>
  <div class="form-group row">
    <label for="text1" class="col-2 col-form-label">No.WA</label> 
    <div class="col-8">
      <div class="input-group">
        <div class="input-group-prepend">
          <div class="input-group-text">
            <i class="fa fa-address-card"></i>
          </div>
        </div> 
        <input id="text1" name="text1" type="text" class="form-control">
      </div>
    </div>
  </div>
  <div class="form-group row">
    <label for="text2" class="col-2 col-form-label">Alamat</label> 
    <div class="col-8">
      <div class="input-group">
        <div class="input-group-prepend">
          <div class="input-group-text">
            <i class="fa fa-envelope"></i>
          </div>
        </div> 
        <input id="text2" name="text2" type="text" class="form-control">
      </div>
    </div>
  </div>
  <div class="form-group row">
    <label class="col-2">Jenis Barang</label> 
    
      <div class="custom-control custom-radio custom-control-inline">
        <input name="radio" id="radio_1" type="radio" class="custom-control-input" value="DM"> 
        <label for="radio_1" class="custom-control-label">Baju Koko</label>
      </div>
    </div>
  </div>
  <div class="form-group row">
    <label class="col-2">Ukuran</label> 
    <div class="col-8">
      <div class="custom-control custom-checkbox custom-control-inline">
        <input name="checkbox" id="checkbox_0" type="checkbox" class="custom-control-input" value="A"> 
        <label for="checkbox_0" class="custom-control-label">S</label>
      </div>
      <div class="custom-control custom-checkbox custom-control-inline">
        <input name="checkbox" id="checkbox_1" type="checkbox" class="custom-control-input" value="B"> 
        <label for="checkbox_1" class="custom-control-label">L</label>
      </div>
      <div class="custom-control custom-checkbox custom-control-inline">
        <input name="checkbox" id="checkbox_2" type="checkbox" class="custom-control-input" value="C"> 
        <label for="checkbox_2" class="custom-control-label">XL</label>
      </div>
      <div class="custom-control custom-checkbox custom-control-inline">
        <input name="checkbox" id="checkbox_3" type="checkbox" class="custom-control-input" value="D"> 
        <label for="checkbox_3" class="custom-control-label">XXL</label>
      </div>
    </div>
  </div>
  <div class="form-group row">
    <label for="select" class="col-2 col-form-label">Jumlah Barang</label> 
    <div class="col-8">
      <select id="select" name="select" class="custom-select">
        <option value="wd">1</option>
        <option value="db">2</option>
        <option value="php">3</option>
        <option value="py">4</option>
        <option value="wd">5</option>
        <option value="db">6</option>
        <option value="php">7</option>
        <option value="py">8</option>
         <option value="php">9</option>
        <option value="py">10</option>
      </select>
    </div>
  </div>
  <div class="form-group row">
    <label for="select" class="col-2 col-form-label">Jenis Pembayaran</label> 
    <div class="col-8">
      <select id="select" name="select" class="custom-select">
        <option value="wd">BCA</option>
        <option value="db">Mandiri</option>
        <option value="php">BRI</option>
        <option value="py">QRIS</option>
        <option value="wd">COD</option>
      </select>
    </div>
  </div>
  <div class="form-group row">
    <label for="select" class="col-2 col-form-label">Jenis Pengiriman</label> 
    <div class="col-8">
      <select id="select" name="select" class="custom-select">
        <option value="wd">SiCepat</option>
        <option value="db">Gosend</option>
        <option value="php">GrabExpress</option>
        <option value="py">JnT</option>
        <option value="wd">JnE</option>
      </select>
    </div>
  </div>
   <div class="form-group row">
    <div class="offset-2 col-8">
      <button name="submit" type="submit" class="btn btn-primary">Submit</button>
    </div>
  </div>
  </div>
</form>
</body>
</html>
