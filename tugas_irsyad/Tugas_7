  <style>
    /* Reset & Dasar */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #e5f3f7;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px 16px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Kartu Bingkai Luar */
    .web-frame {
      width: 100%;
      max-width: 1120px;
      background-color: #ffffff;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 70, 90, 0.12);
      display: flex;
      flex-direction: column;
    }

    /* HEADER */
    header {
      background-color: #019eb2;
      padding: 16px 48px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: #ffffff;
    }

    /* Simbol Infinity Logo */
    .infinity-icon {
      width: 58px;
      height: 28px;
      position: relative;
    }

    .infinity-icon::before,
    .infinity-icon::after {
      content: "";
      box-sizing: content-box;
      position: absolute;
      top: 0;
      left: 0;
      width: 16px;
      height: 16px;
      border: 5px solid #ffffff;
      border-radius: 50px 50px 0 50px;
      transform: rotate(-45deg);
    }

    .infinity-icon::after {
      left: auto;
      right: 0;
      border-radius: 50px 50px 50px 0;
      transform: rotate(45deg);
    }

    .brand-title {
      font-size: 11px;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      margin-top: -2px;
      font-weight: 500;
      letter-spacing: 0.3px;
    }

    /* Navigasi Kanan Header */
    .top-nav {
      display: flex;
      gap: 36px;
    }

    .top-nav a {
      color: #ffffff;
      text-decoration: none;
      font-size: 17px;
      font-family: serif, "Times New Roman", Times;
      letter-spacing: 0.5px;
      transition: opacity 0.2s;
    }

    .top-nav a:hover {
      opacity: 0.8;
      text-decoration: underline;
    }

    /* AREA TENGAH (3 KOLOM) */
    .main-body {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      min-height: 480px;
    }

    /* Sidebar Kiri - Kuning */
    .sidebar-left {
      width: 175px;
      background-color: #ffff00;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 36px 14px 20px;
      flex-shrink: 0;
    }

    .ad-illustration {
      width: 110px;
      height: 130px;
      margin-bottom: 24px;
    }

    .ad-divider {
      width: 100%;
      border: none;
      border-top: 1.5px dashed #0e9149;
      margin-bottom: 14px;
    }

    .ad-caption {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #2b2b2b;
      font-weight: 500;
      text-align: center;
    }

    /* Area Artikel - Putih */
    .content-area {
      flex: 1;
      background-color: #ffffff;
      padding: 34px 44px;
      display: flex;
      flex-direction: column;
    }

    .article-title {
      font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 27px;
      font-weight: 700;
      color: #111111;
      margin-bottom: 22px;
      letter-spacing: -0.3px;
    }

    .article-text {
      font-family: "Times New Roman", Times, serif;
      font-size: 15px;
      line-height: 1.45;
      color: #1c1c1c;
      text-align: justify;
      margin-bottom: 16px;
    }

    /* Sidebar Kanan - Kuning */
    .sidebar-right {
      width: 175px;
      background-color: #eeea1b;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px 10px;
      gap: 16px;
      flex-shrink: 0;
    }

    .sidebar-right a {
      color: #0b457b;
      text-decoration: underline;
      font-family: serif, "Times New Roman", Times;
      font-size: 15.5px;
      font-weight: 600;
      transition: color 0.2s;
    }

    .sidebar-right a:hover {
      color: #042442;
    }

    /* FOOTER */
    footer {
      background-color: #019eb2;
      padding: 13px 20px;
      text-align: center;
      color: #ffffff;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      font-size: 13px;
      letter-spacing: 0.2px;
    }

    /* Responsif untuk Layar Kecil / Mobile */
    @media (max-width: 860px) {
      .main-body {
        flex-direction: column;
      }

      .sidebar-left,
      .sidebar-right {
        width: 100%;
        padding: 20px;
      }

      .sidebar-right {
        flex-direction: row;
        gap: 20px;
        flex-wrap: wrap;
      }

      .content-area {
        padding: 24px 20px;
      }

      .top-nav {
        gap: 18px;
      }

      .top-nav a {
        font-size: 15px;
      }

      header {
        padding: 14px 20px;
      }
    }
  </style>
