<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Animasi Bola dan Teks Berjalan</title>
  <style>
    body {
      min-height: 50vh;
      display: flex;
      justify-content: left;
      align-items: center;
      position: relative;
      background: #cacae6;
      overflow-x: hidden;
      font-family: sans-serif;
    }

    .container {
      position: relative;
      width: 100%;
      max-width: 1000px;
      height: 180px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      
    }

    .bola {
  animation-name: gelinding;
  animation-duration: 3s;
  animation-iteration-count: infinite; /* Berulang terus tanpa henti */
  animation-direction: alternate;      /* Bolak-balik ke kanan dan ke kiri */
  animation-timing-function: ease-in-out;
}
    

  
    
    
     .lingkaran-merah {
            width: 150px;
            height: 150px;
            background-color: #ca113f;
            border-radius: 50%;
            position: absolute;
            top: 50px;
            animation: jalanDariKiri 8s linear infinite;
        }

       
        @keyframes jalanDariKiri {
            0% { 
                
                transform: translateX(-200px); 
            }
            100% { 
              
                transform: translateX(100vw); 
            }
        }

  
/* Kontainer lintasan: background tetap diam di sini */
/* Kontainer lintasan: background tetap diam */
.track-container {
  position: relative;
  width: 100%;
  height: 70px;
  background-color: aquamarine;
  overflow: hidden;
  display: flex;
  align-items: center;
  container-type: inline-size; /* Mengukur lebar frame kontainer */
}

/* Teks yang memantul di dalam lintasan */
.track-text {
  position: absolute;
  left: 0;
  white-space: nowrap;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #c71919;
  /* ease-in-out membuat efek deselerasi halus saat memantul */
  animation: bounceText 4s ease-in-out infinite alternate;
}

/* Gerakan bolak-balik di dalam frame */
@keyframes bounceText {
  0% {
    /* Menempel di ujung kiri frame */
    transform: translateX(0);
  }
  100% {
    /* Bergerak ke ujung kanan frame tanpa terpotong keluar */
    transform: translateX(calc(100cqw - 100%));
  }
}
  </style>
</head>
<body>
 <div class="lingkaran-merah"></div>

  <div class="track-container">
  <span class="track-text">SELAMAT BELAJAR WEB DESIGN</span>
</div>
    <div class="track-wrapper">
      
    </div>
  </div>

</body>
</html>
